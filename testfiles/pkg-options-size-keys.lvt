% pkg-options-size-keys: size={...}.  The defaults given in the list are
% stored with the base of the end of the list, whatever the order of the
% keys; a base= inside a default wins (it comes after); keys not given keep
% their default.
\input{regression-test}
\documentclass{article}
\usepackage[size={figure={height=5}, base=mm, gap=2,
  program={width=0.8, base=text}}]{mypackage}
\input{mytest-helpers}
\makeatletter
\begin{document}
\START
\TEST{Keyed size values}{%
  \SHOWVAR{l__mypackage_size_base_tl}
  \SHOWVAR{l__mypackage_size_gap_tl}
  \SHOWVAR{l__mypackage_size_gap_base_tl}
  \SHOWVAR{l__mypackage_size_figure_tl}
  \SHOWVAR{l__mypackage_size_subfigure_tl}
  \SHOWVAR{l__mypackage_size_program_tl}
}
\TEST{Sizes that result}{%
  \setbox0\hbox{\myinclude{square.jpg}}%
  \TYPE{default figure (height=5, base=mm): \the\ht0}%
  \setbox0\hbox{\myinclude[height=10]{square.jpg}}%
  \TYPE{height=10 (base=mm): \the\ht0}%
}
\end{document}
