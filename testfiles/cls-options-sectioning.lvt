% cls-options-sectioning: the shorthand sectioning=<value> sets every level,
% including the annex and the bibliography.
\input{regression-test}
\documentclass[sectioning=nobreak]{myreport}
\input{mytest-helpers}
\makeatletter
\begin{document}
\START
\TEST{Shorthand}{%
  \SHOWVAR{l__myreport_sectioning_part_tl} \SHOWVAR{l__myreport_sectioning_chapter_tl}
  \SHOWVAR{l__myreport_sectioning_section_tl} \SHOWVAR{l__myreport_sectioning_subsection_tl}
  \SHOWVAR{l__myreport_sectioning_subsubsection_tl} \SHOWVAR{l__myreport_sectioning_annex_tl}
  \SHOWVAR{l__myreport_sectioning_bib_tl}
}
\end{document}
