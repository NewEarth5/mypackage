% cls-load: the class loads with all options at their default value.
\input{regression-test}
\documentclass{myreport}
\input{mytest-helpers}
\makeatletter
\begin{document}
\START
\TEST{Class option values (defaults)}{%
  \SHOWVAR{l__myreport_text_fontsize_tl}
  \SHOWVAR{l__myreport_text_fontfamily_tl}
  \SHOWVAR{l__myreport_text_lang_tl}
  \SHOWVAR{l__myreport_position_tl}
  \SHOWVAR{l__myreport_sectioning_part_tl}
  \SHOWVAR{l__myreport_sectioning_chapter_tl}
  \SHOWVAR{l__myreport_sectioning_section_tl}
  \SHOWVAR{l__myreport_sectioning_subsection_tl}
  \SHOWVAR{l__myreport_sectioning_subsubsection_tl}
  \SHOWVAR{l__myreport_sectioning_annex_tl}
  \SHOWVAR{l__myreport_sectioning_bib_tl}
}
\TEST{Values received by mypackage}{%
  \SHOWVAR{l__mypackage_lang_tl}
  \SHOWVAR{l__mypackage_path_images_tl}
  \SHOWVAR{l__mypackage_path_code_tl}
  \SHOWVAR{l__mypackage_path_sources_tl}
  \SHOWVAR{l__mypackage_position_figure_tl}
  \SHOWVAR{l__mypackage_position_table_tl}
  \SHOWVAR{l__mypackage_toc_depth_int}
  \SHOWVAR{l__mypackage_toc_annexdepth_int}
  \SHOWVAR{l__mypackage_toc_bibdepth_int}
}
\TEST{Base class, size, fonts}{%
  \TYPE{report class: \@ifclassloaded{report}{yes}{no}}%
  \TYPE{size: \f@size pt, baselineskip \the\baselineskip}%
  \TYPE{family: \f@family, familydefault: \familydefault,
    encoding: \f@encoding}%
  \TYPE{paper: \the\paperwidth\space x \the\paperheight}%
  \@for\@tempa:=amsmath,amsfonts,amssymb,mypackage\do{%
    \@ifpackageloaded\@tempa
      {\TYPE{\@tempa: loaded}}{\TYPE{\@tempa: MISSING}}}%
}
\TEST{Words}{\SHOWNAMES}
\TEST{Title-page defaults}{%
  \SHOWVAR{g__myreport_course_tl} \SHOWVAR{g__myreport_title_tl} \SHOWVAR{g__myreport_date_tl}
  \SHOWVAR{g__myreport_acyear_tl} \SHOWVAR{g__myreport_author_seq} \SHOWVAR{g__myreport_professor_seq}
}
\end{document}
