% cls-font-lmss: text={fontfamily=lmss} must load the matching font package and
% make lmss the family of \normalfont everywhere (body, captions, footnotes).
\input{regression-test}
\documentclass[text={fontfamily=lmss}]{myreport}
\input{mytest-helpers}
\makeatletter
\begin{document}
\START
\TEST{Font family}{%
  \TYPE{body: \f@family}%
  \begingroup\normalfont\TYPE{normalfont: \f@family}\endgroup
  \begingroup\footnotesize\TYPE{footnotesize: \f@family}\endgroup
  \TYPE{familydefault: \familydefault; rmdefault: \rmdefault;
    sfdefault: \sfdefault; ttdefault: \ttdefault}%
  \SHOWTEXT{Ab}%
}
\end{document}
