% \myref[<prefix>]{<type>:<label>}: "<prefix><Word> <number>" (or the word          %
% alone for the abstract and the introduction), linked to the label. The            %
% word is chosen from the beginning of <type> (fig..., eq..., tab..., ...).         %
% \myseeref[<prefix>]{<label>}: the same, preceded by babel's \seename.             %
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% {<beginning of the type>} {<word>} {<n: with the number, w: word only>}
\seq_const_from_clist:Nn \c__mypackage_ref_types_seq {
  { fig } { \myfigurename } { n },
  { eq } { \myequationname } { n },
  { tab } { \mytablename } { n },
  { abst } { \myabstractname } { w },
  { intro } { \myintroductionname } { w },
  { part } { \mypartname } { n },
  { chap } { \mychaptername } { n },
  { sec } { \mysectionname } { n },
  { subsec } { \mysubsectionname } { n },
  { subsubsec } { \mysubsubsectionname } { n },
  { code } { \myprogramname } { n },
  { ann } { \myannexname } { n },
}
\regex_const:Nn \c__mypackage_ref_type_regex { \A ([^:]*) : }
\cs_generate_variant:Nn \regex_extract_once:NnNTF { NV }
\str_new:N \l__mypackage_ref_type_str
\seq_new:N \l__mypackage_ref_seq
\tl_new:N  \l__mypackage_ref_text_tl
\NewDocumentCommand \myref { O{} m } {
  \str_set:Nn \l__mypackage_ref_type_str {#2}
  \regex_extract_once:NVNTF \c__mypackage_ref_type_regex \l__mypackage_ref_type_str \l__mypackage_ref_seq {
    \str_set:Ne \l__mypackage_ref_type_str { \seq_item:Nn \l__mypackage_ref_seq { 2 } }
  } {
    \str_clear:N \l__mypackage_ref_type_str
  }
  \tl_set:Nn \l__mypackage_ref_text_tl { #1 \ref* {#2} }
  \seq_map_inline:Nn \c__mypackage_ref_types_seq {
    \__mypackage_ref_match:nnnnn {#1} {#2} ##1
  }
  \use:e {
    \exp_not:N \hyperref [ \exp_not:n {#2} ] { \exp_not:V \l__mypackage_ref_text_tl }
  }
}
\cs_new_protected:Npn \__mypackage_ref_match:nnnnn #1#2#3#4#5 {
  \str_if_eq:eeT {
    \str_range:Nnn \l__mypackage_ref_type_str { 1 } { \str_count:n {#3} }
  } {
    \tl_to_str:n {#3}
