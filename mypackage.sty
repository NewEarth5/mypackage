%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%% WORDS %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Every word <w> is a macro \my<w>name.  The words that babel already translates    %
% are *defined as* babel's word (\def\myfigurename{\figurename}) so that they       %
% follow \selectlanguage; the other ones come from the tables below.  A table       %
% may also replace a babel word (French: "Liste des tables").                       %
%                                                                                   %
% \mypackage@definewords{<table>}{<word>=<text>, ...}  defines a table and          %
% \mypackage@registerwords{<babel names>}{<table>}      uses it for these           %
% languages (through babel's \captions<language>).                                  %
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\ExplSyntaxOn
\cs_new_protected:Npn \__mypackage_words_babel: {
  \cs_set:Npn \mycontentsname { \contentsname }
  \cs_set:Npn \mylistfigurename { \listfigurename }
  \cs_set:Npn \mylisttablename { \listtablename }
  \cs_set:Npn \mybibname { \bibname }
  \cs_set:Npn \myabstractname { \abstractname }
  \cs_set:Npn \mychaptername { \chaptername }
  \cs_set:Npn \mypartname { \partname }
  \cs_set:Npn \myfigurename { \figurename }
  \cs_set:Npn \mytablename { \tablename }
}
\cs_new_protected:Npn \mypackage@definewords #1#2 {
  \prop_gclear_new:c { g__mypackage_words_ #1 _prop }
  \keyval_parse:nnn {
    \__mypackage_words_put:nn {#1}
  } {
    \__mypackage_words_put:nnn {#1}
  } {
    #2
  }
}
\cs_new_protected:Npn \__mypackage_words_put:nnn #1#2#3 {
  \prop_gput:cnn { g__mypackage_words_ #1 _prop } {#2} {#3}
}
\cs_new_protected:Npn \__mypackage_words_put:nn #1#2 {
  \prop_gput:cnn { g__mypackage_words_ #1 _prop } {#2} { }
}
\cs_new_protected:Npn \__mypackage_words_use:n #1 {
  \__mypackage_words_babel:
  \prop_map_inline:cn { g__mypackage_words_ #1 _prop } {
    \cs_set:cpn { my ##1 name } {##2}
  }
}
\cs_new_protected:Npn \mypackage@registerwords #1#2 {
  \clist_map_inline:nn {#1} {
    \exp_args:Nc \addto { captions ##1 } { \__mypackage_words_use:n {#2} }
  }
}
