\ExplSyntaxOn
\tl_new:N  \l__mypackage_lang_tl
\tl_new:N  \l__mypackage_path_images_tl
\tl_new:N  \l__mypackage_path_code_tl
\tl_new:N  \l__mypackage_path_sources_tl
\tl_new:N  \l__mypackage_position_figure_tl
\tl_new:N  \l__mypackage_position_table_tl
\tl_new:N  \l__mypackage_position_program_tl
\tl_new:N  \l__mypackage_position_pseudocode_tl
\int_new:N \l__mypackage_toc_depth_int
\int_new:N \l__mypackage_toc_annexdepth_int
\int_new:N \l__mypackage_toc_bibdepth_int
\keys_define:nn { mypackage } {
  lang.code:n = {
    \tl_set:Ne \l__mypackage_lang_tl {#1}
  },
  lang.initial:n = british ,
  paths.code:n = {
    \keys_set:no { mypackage / paths } {#1}
  },
  position.code:n = {
    \__mypackage_position_set:o {#1}
  },
  toc.code:n = {
    \keys_set:no { mypackage / toc } {#1}
  },
}
\keys_define:nn { mypackage / paths } {
  images.tl_set:N = \l__mypackage_path_images_tl,
  images.initial:n = images/,
  code.tl_set:N = \l__mypackage_path_code_tl,
  code.initial:n = code/,
  sources.tl_set:N = \l__mypackage_path_sources_tl,
  sources.initial:n = sources/sources.bib,
}
\keys_define:nn { mypackage / position } {
  figure.tl_set:N = \l__mypackage_position_figure_tl,
  figure.initial:n = h,
  table.tl_set:N = \l__mypackage_position_table_tl,
  table.initial:n = h,
  program.tl_set:N = \l__mypackage_position_program_tl,
  program.initial:n = h,
  pseudocode.tl_set:N = \l__mypackage_position_pseudocode_tl,
  pseudocode.initial:n = h,
}
\keys_define:nn { mypackage / toc } {
  depth.int_set:N = \l__mypackage_toc_depth_int,
  depth.initial:n = 2,
  annexdepth.int_set:N = \l__mypackage_toc_annexdepth_int,
  annexdepth.initial:n = 0,
  bibdepth.int_set:N = \l__mypackage_toc_bibdepth_int,
  bibdepth.initial:n = 1,
}
\cs_new_protected:Npn \__mypackage_position_set:n #1 {
  \tl_if_blank:nF {#1} {
    \tl_if_in:nnTF {#1} { = } {
      \keys_set:nn { mypackage / position } {#1}
    } {
      \clist_map_inline:nn {
        figure , table , program , pseudocode
      } {
        \tl_set:cn { l__mypackage_position_ ##1 _tl } {#1}
      }
    }
  }
}
\cs_generate_variant:Nn \__mypackage_position_set:n { o }
\ProcessKeyOptions [ mypackage ]
\ExplSyntaxOff
