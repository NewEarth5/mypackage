    \addtocounter{mycurrentdepth}{1}%
  \else%
    \ifGlobalMychapterUsed%
    \else%
      \addtocounter{mycurrentdepth}{-1}%
    \fi%
  \fi%
  \ifMyannexUsed%
    \ifnum \value{mycurrentdepth} > \value{myannexdepth} \relax%
    \else%
      \addcontentsline{mytoc}{#1}{#2}%
    \fi%
  \else%
    \ifMybibUsed%
      \ifnum \value{mycurrentdepth} > \value{mybibdepth} \relax%
      \else%
        \addcontentsline{mytoc}{#1}{#2}%
      \fi%
    \else%
      \ifnum \value{mycurrentdepth} > \value{mytocdepth} \relax%
      \else%
        \addcontentsline{mytoc}{#1}{#2}%
      \fi%
    \fi%
  \fi%
