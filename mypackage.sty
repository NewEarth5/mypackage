%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%% PACKAGE OPTIONS PROCESSING %%%%%%%%%%%%%%%%%%%%%% DESCRIPTION %%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\ifx\mypackage@paths\@empty                        % Paths sub-options              %
\else                                              %                                %
  \kvsetkeys@expandafter{%                         %                                %
    mypackagepaths%                                %                                %
  }{%                                              %                                %
    \mypackage@paths%                              %                                %
  }                                                %                                %
\fi                                                %                                %
\ifx\mypackage@position\@empty                     % Position sub-options           %
\else                                              %                                %
  \IfSubStr{\mypackage@position}{=}{               %                                %
    \kvsetkeys@expandafter{%                       %                                %
      mypackagepos%                                %                                %
    }{%                                            %                                %
      \mypackage@position%                         %                                %
    }                                              %                                %
  }{                                               %                                %
    \expandafter\def                               %                                %
    \csname mypackage@pos@figure\endcsname{%       %                                %
      \mypackage@position%                         %                                %
    }                                              %                                %
    \expandafter\def                               %                                %
    \csname mypackage@pos@table\endcsname{%        %                                %
      \mypackage@position%                         %                                %
    }                                              %                                %
    \expandafter\def                               %                                %
    \csname mypackage@pos@program\endcsname{%      %                                %
      \mypackage@position%                         %                                %
    }                                              %                                %
    \expandafter\def                               %                                %
    \csname mypackage@pos@pseudocode\endcsname{%   %                                %
      \mypackage@position%                         %                                %
    }                                              %                                %
  }                                                %                                %
\fi                                                %                                %
\ifx\mypackage@toc \@empty                         % TOC sub-options                %
\else                                              %                                %
  \kvsetkeys@expandafter{%                         %                                %
    mypackagetoc%                                  %                                %
  }{%                                              %                                %
    \mypackage@toc%                                %                                %
  }                                                %                                %
\fi                                                %                                %
