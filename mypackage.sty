%%%%%% PROGRAMS %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% \myincludeprogram[<options>]{<file>}{<language>} a listing of the code            %
%     folder; options: bgcol, framecol, numcol, numbgcol, numwidth (auto: two       %
%     millimetres per digit of the last line number), minted={...}.                 %
% \myprogram(*)[<options>]{<label>}{<file>}{<language>}[<short>]{<caption>}         %
%     [<placement>] the same with a caption and the label                           %
%     code:<extension>:<label>.                                                     %
%                                                                                   %
% \myprogram typesets the listing once in a box: if the box and its caption are     %
% shorter than \textheight - 1cm, the box goes into a float; if not, the            %
% listing is typeset again in the text flow, where it can break across pages.       %
% When the number of non-empty lines of the file already shows that the listing     %
% is too tall, the box is not made at all: every listing is typeset once,           %
% except the ones whose height must be measured and that do not fit (twice).        %
% (0.6.5 typeset each listing three times.)                                         %
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% The tcolorbox listing: [<minted options>]{<file>}{<language>}{<background>}  %
% {<frame>}{<width of the numbers>}{<background of the numbers>}              %
\newtcbinputlisting{\mypackage@listing}[7][]{%
  before skip=7pt,%
  breakable,%
  enhanced,%
  listing only,%
  listing file={\mypackage@codepath #2},%
  minted language=#3,%
  colback=#4,%
  colframe=#5,%
  left=#6 - 1mm,%
  overlay={%
    \begin{tcbclipinterior}%
      \fill[#7] (frame.south west) rectangle ([xshift=#6]frame.north west);%
    \end{tcbclipinterior}%
  },%
  minted options={%
    fontsize=\normalsize,%
    linenos=true,%
    numbersep=1mm,%
    breaklines=true,%
    breakautoindent=true,%
    mathescape=true,%
    autogobble=true,%
    #1%
  },%
}
