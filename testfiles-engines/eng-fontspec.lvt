% eng-fontspec: the user selects an OpenType font with fontspec; the class
% must not override it (text={fontfamily=...} is left at its default).
\input{regression-test}
\documentclass{myreport}
\usepackage{fontspec}
\setmainfont{texgyrepagella-regular.otf}[
  BoldFont=texgyrepagella-bold.otf, ItalicFont=texgyrepagella-italic.otf,
  BoldItalicFont=texgyrepagella-bolditalic.otf]
\input{mytest-helpers}
\begin{document}
\START
\makeatletter\TYPE{family: \f@family; encoding: \f@encoding}\makeatother
\mychapter{Chapter}
\myfigure{wide.png}{Caption in the main font: é.}
\TEST{Typeset text}{\SHOWTEXT{Text é}}
\end{document}
